RewriteEngine On

# Redirect production traffic to HTTPS while allowing local development.
# #RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
# #RewriteCond %{HTTPS} !=on
# #RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
#   Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), midi=(), usb=(), browsing-topics=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://discord.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://activitycheck.top https://cdn.aazgroup.co https://cdn.discordapp.com https://media.discordapp.net; connect-src 'self' https://discord.com; frame-src https://discord.com"
</IfModule>

<FilesMatch "(^\.env|\.bak$|\.sql$|\.log$|\.ini$|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
RewriteRule .* - [F]

RewriteRule ^id/([a-zA-Z0-9._-]+)/?$ dashboard/profile.php?u=$1 [L,QSA]
RewriteRule ^profile/?$ dashboard/profile.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]

ErrorDocument 404 /404.html
