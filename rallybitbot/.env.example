# Discord application
DISCORD_BOT_TOKEN=
OWNER_ID=
SHARD_COUNT=1
BOT_PREFIX=!

# Website and support links
DASHBOARD_URL=https://rallybit.pages.dev/dashboard
SUPPORT_SERVER_URL=https://discord.gg/your-server

# Optional identity for this bot instance. Name/avatar changes are global to
# this Discord application. Use a separate application for customer branding.
BOT_PROFILE_NAME=
BOT_PROFILE_AVATAR_URL=
# online, idle, dnd, or offline
BOT_PRESENCE_STATUS=online

# Pro preview: AI-assisted channel and role naming. OpenRouter's free router
# requires an API key and is rate limited; select a fixed model if preferred.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Local dashboard bridge
API_HOST=127.0.0.1
API_PORT=8080
BOT_API_SECRET=
TOPGG_WEBHOOK_TOKEN=

# SECURITY INTENTS
# Enable Server Members Intent and Message Content Intent in the Discord Developer Portal.
# Message Content is used only by optional invite/term filtering and security message logs.
